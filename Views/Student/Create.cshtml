@model Student
@{
    ViewData["Title"] = "Register";
}

<h2>Student Registration</h2>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <label asp-for="Name">Full Name</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="text-danger"></span>

    <label asp-for="Email">Email Address</label>
    <input asp-for="Email" />
    <span asp-validation-for="Email" class="text-danger"></span>

    <label asp-for="Course">Course</label>
    <select asp-for="Course" asp-items="new SelectList(CourseCatalog.Courses)">
        <option value="">-- Select a course --</option>
    </select>
    <span asp-validation-for="Course" class="text-danger"></span>

    <label asp-for="Semester">Semester (1 - 8)</label>
    <input asp-for="Semester" type="number" />
    <span asp-validation-for="Semester" class="text-danger"></span>

    <p style="margin-top: 20px;">
        <button type="submit" class="btn">Register</button>
        <a class="btn btn-light" asp-action="Index">Cancel</a>
    </p>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
