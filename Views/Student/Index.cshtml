@model List<Student>
@{
    ViewData["Title"] = "Student List";
}

<h2>Registered Students</h2>

@if (Model.Count == 0)
{
    <p>No students have been registered yet.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Course</th>
                <th>Semester</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.Id</td>
                    <td>@student.Name</td>
                    <td>@student.Course</td>
                    <td>@student.Semester</td>
                    <td><a asp-action="Details" asp-route-id="@student.Id">Details</a></td>
                </tr>
            }
        </tbody>
    </table>
}

<p><a class="btn" asp-action="Create">Register New Student</a></p>
